generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PROFESSOR
}

enum Priority {
  HIGH
  MODERATE
  REGULAR
}

enum Mode {
  FACE_TO_FACE
  ONLINE
}

enum Concern {
  THESIS
  CAPSTONE
  PAPER
  ACADEMIC
  OTHER
}

enum ApptStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  RESCHEDULED
  WAITING
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  LATE
  NO_SHOW
}

enum DocStatus {
  MISSING
  SUBMITTED
  UNDER_REVIEW
  NEEDS_FIX
  REVIEWED
}

enum WaitStatus {
  WAITING
  OFFERED
  APPROVED
  SKIPPED
}

enum RecordStatus {
  DRAFT
  SENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          Role
  emailVerified Boolean  @default(false)
  program       String?
  department    String?
  createdAt     DateTime @default(now())

  codes         VerificationCode[]
  settings      ProfessorSettings?
  availability  AvailabilityDay[]
  asStudent     Appointment[]      @relation("student")
  asProfessor   Appointment[]      @relation("professor")
  waitlist      WaitlistEntry[]
  notifications Notification[]
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model CodeSendLog {
  id        String   @id @default(cuid())
  emailKey  String
  ip        String
  createdAt DateTime @default(now())

  @@index([emailKey, createdAt])
  @@index([ip, createdAt])
}

model ProfessorSettings {
  professorId       String  @id
  professor         User    @relation(fields: [professorId], references: [id])
  durationMin       Int     @default(30)
  graceMin          Int     @default(5)
  autoCancel        Boolean @default(true)
  requireReschedule Boolean @default(true)
  building          String  @default("")
  floor             String  @default("")
  room              String  @default("")
  meetingLink       String?
}

model AvailabilityDay {
  id          String  @id @default(cuid())
  professorId String
  professor   User    @relation(fields: [professorId], references: [id])
  weekday     Int
  enabled     Boolean @default(true)
  startMin    Int
  endMin      Int
  faceToFace  Boolean @default(true)
  online      Boolean @default(false)

  @@unique([professorId, weekday])
}

model Appointment {
  id           String      @id @default(cuid())
  studentId    String
  professorId  String
  student      User        @relation("student", fields: [studentId], references: [id])
  professor    User        @relation("professor", fields: [professorId], references: [id])
  startsAt     DateTime
  endsAt       DateTime
  mode         Mode
  concern      Concern
  title        String
  description  String
  deadline     DateTime?
  deadlineNote String?
  priority     Priority    @default(REGULAR)
  status       ApptStatus  @default(PENDING)
  queueNumber  Int?
  qrToken      String?     @unique
  qrUsedAt     DateTime?
  checkedInAt  DateTime?
  startedAt    DateTime?
  slotKey      String?     @unique
  createdAt    DateTime    @default(now())

  documents  Document[]
  record     ConsultationRecord?
  evaluation Evaluation?

  @@index([professorId, startsAt])
  @@index([studentId, status])
}

model WaitlistEntry {
  id          String     @id @default(cuid())
  studentId   String
  student     User       @relation(fields: [studentId], references: [id])
  professorId String
  startsAt    DateTime
  status      WaitStatus @default(WAITING)
  createdAt   DateTime   @default(now())
}

model Document {
  id               String      @id @default(cuid())
  appointmentId    String
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  requirement      String
  required         Boolean     @default(true)
  fileName         String?
  fileSize         Int?
  storageKey       String?
  status           DocStatus   @default(MISSING)
  precheck         Json?
  professorComment String?
  submittedAt      DateTime?
}

model ConsultationRecord {
  id            String       @id @default(cuid())
  appointmentId String       @unique
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])
  privateNotes  String       @default("")
  concerns      String       @default("")
  feedback      String       @default("")
  status        RecordStatus @default(DRAFT)
  sentAt        DateTime?
  revisions     Revision[]
}

model Revision {
  id          String             @id @default(cuid())
  recordId    String
  record      ConsultationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  text        String
  dueDate     DateTime?
  completedAt DateTime?
}

model Evaluation {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  text      String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}